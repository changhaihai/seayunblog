---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto max-w-4xl px-6">
  <!-- 分隔线 -->
  <div class="border-t border-dashed border-black/10 dark:border-white/15 my-8"></div>

  <!-- 版权信息区域 -->
  <div class="rounded-xl bg-black/5 dark:bg-white/5 p-6 mb-6 transition-all">
    <div class="text-sm text-center space-y-2 text-black/70 dark:text-white/70">
      <!-- 备案号 -->
      <div>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
          鄂ICP备2026018599号
        </a>
      </div>

      <!-- 版权 -->
      <div>
        &copy; {currentYear}
        <a class="font-medium text-primary hover:opacity-80 transition-opacity" href="https://github.com/Ad-closeNN" target="_blank" rel="noopener noreferrer">
          {profileConfig.name}
        </a>
        &nbsp;|&nbsp;
        <a class="font-medium text-primary hover:opacity-80 transition-opacity" href="https://github.com/Ad-closeNN/blog-fuwari" target="_blank" rel="noopener noreferrer">
          博客开源
        </a>
      </div>

      <!-- RSS / 站点地图 -->
      <div class="space-x-3">
        <a class="hover:text-primary transition-colors" target="_blank" href={url('rss.xml')}>RSS</a>
        <a class="hover:text-primary transition-colors" target="_blank" href={url('sitemap-index.xml')}>站点地图</a>
      </div>

      <!-- 技术栈 -->
      <div>
        由
        <a class="text-primary hover:opacity-80 transition-opacity" target="_blank" href="https://astro.build">Astro</a>
        +
        <a class="text-primary hover:opacity-80 transition-opacity" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
        强力驱动
      </div>

      <!-- 部署 & CDN -->
      <div>
        构建于
        <a class="text-primary hover:opacity-80 transition-opacity" target="_blank" href="https://www.cloudflare.com">Cloudflare</a>
        &nbsp;全球节点
      </div>
    </div>

    <!-- Cloudflare Logo -->
    <div class="flex justify-center mt-4">
      <img
        src="https://www.cloudflare.com/img/logo-cloudflare-dark.svg"
        alt="Cloudflare"
        class="h-7 select-none pointer-events-none"
        draggable="false"
      >
    </div>
  </div>
</footer>
